# ============================================================
#  .env  —  Environment Configuration (Copy to .env to use)
# ============================================================

# AI API Configuration
# Leave blank to use default Pollinations.ai
# AI_URL=https://text.pollinations.ai/

# Optional: Custom AI endpoints
# AI_URL=https://api.openai.com/v1/chat/completions
# AI_TOKEN=sk-your-api-key-here

# Logging
# Set to False to disable persistent memory saving
# PERSIST_MEMORY=True

# Voice Configuration
# ENERGY_THRESHOLD=300
# WAKE_TIMEOUT=5
# CMD_TIMEOUT=10
